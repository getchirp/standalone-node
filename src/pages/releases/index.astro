---
import Base from '../../layouts/Base.astro';
import ReleaseTimeline from '../../components/ReleaseTimeline.astro';
import SubscribeBlock from '../../components/SubscribeBlock.astro';
import '../../styles/blog.css';
import '../../styles/changelog.css';
import { makeIds, assembleGraph, buildPiece } from '@jdevalk/seo-graph-core';
import { buildWebSite, buildWebPage } from '@jdevalk/seo-graph-core';
import { getCollection } from 'astro:content';

const siteUrl = 'https://chirp.md';
const pageUrl = siteUrl + '/releases';
const ids = makeIds({ siteUrl });

const pageGraph = assembleGraph([
  buildWebSite({ url: siteUrl, name: 'Chirp', description: 'Modern publishing platform for teams.', inLanguage: 'en' }, ids),
  buildPiece({ '@type': 'Organization', url: siteUrl, name: 'Chirp', description: 'Modern publishing platform for teams.' }),
  buildWebPage({ url: pageUrl, name: 'Releases - Chirp', description: 'Every release, every fix, every improvement - in the order they shipped.', inLanguage: 'en' }, ids),
]);

const allReleases = await getCollection('release');
allReleases.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const products = [...new Set(allReleases.map((r) => r.data.product))];
---


<Base title="Releases - what shipped" description="Every release, every fix, every improvement - in the order they shipped." ogImage="/og/releases.jpg" graph={pageGraph} current="releases">
  <header class="changelog-hero" aria-labelledby="changelog-title">
    <div class="eyebrow">Releases</div>
    <h1 id="changelog-title">What shipped.</h1>
    <p class="lede">Every release, every fix, every improvement - in the order they shipped.</p>
    <nav class="changelog-filters" aria-label="Filter by product">
      <a class="blog-filter-pill active" href="/releases" aria-current="true">All versions</a>
      {products.map((product) => (
        <a class="blog-filter-pill" href={`/releases#${product.replace('/', '-')}`}>{product}</a>
      ))}
    </nav>
  </header>

  <section class="release-timeline-section" aria-label="Releases by month">
    <ReleaseTimeline releases={allReleases} />
  </section>

  <SubscribeBlock />
</Base>
