---
import Base from '../layouts/Base.astro';
import FuzzyRedirect from '@jdevalk/astro-seo-graph/FuzzyRedirect.astro';
---

<Base
  title="Page not found - Chirp"
  description="The page you're looking for doesn't exist. Let us help you find what you need."
>
  <div class="not-found-page">
    <h1>Page not found</h1>
    <p>
      The page you're looking for doesn't exist or has moved.
    </p>
    <FuzzyRedirect />
    <a href="/" class="button button-primary">
      Go home
    </a>
  </div>
</Base>

<style>
  .not-found-page {
    display: flex;
    min-height: 60vh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 126px 28px 96px;
    text-align: center;
  }

  .not-found-page h1 {
    font-size: clamp(2.9rem, 6.6vw, 5.4rem);
    line-height: 0.98;
  }

  .not-found-page p {
    max-width: 480px;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.6;
  }

  .not-found-page .button {
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .not-found-page {
      padding-inline: 20px;
    }
  }

  @media (max-width: 480px) {
    .not-found-page {
      padding-inline: 16px;
    }
  }
</style>
