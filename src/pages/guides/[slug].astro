---
import Base from '../../layouts/Base.astro';
import '../../styles/docs.css';
import { getCollection, render } from 'astro:content';
import { makeIds, assembleGraph, buildPiece } from '@jdevalk/seo-graph-core';
import { buildWebSite, buildWebPage } from '@jdevalk/seo-graph-core';

export async function getStaticPaths() {
  const guides = await getCollection('guide');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const { title, description, section } = guide.data;
const siteUrl = 'https://chirp.md';
const pageUrl = `${siteUrl}/guides/${guide.id}`;
const ids = makeIds({ siteUrl });

const pageGraph = assembleGraph([
  buildWebSite({ url: siteUrl, name: 'Chirp', description: 'A local visual editor for Astro content collections.', inLanguage: 'en' }, ids),
  buildPiece({ '@type': 'Organization', url: siteUrl, name: 'Chirp', description: 'A local visual editor for Astro content collections.' }),
  buildWebPage({ url: pageUrl, name: `${title} - Chirp Guides`, description: description || title, inLanguage: 'en' }, ids),
]);

const allGuides = await getCollection('guide');
allGuides.sort((a, b) => a.data.order - b.data.order);

const sectionOrder = ['Getting Started', 'Content', 'Editor'];
const grouped = sectionOrder
  .map((label) => ({ label, items: allGuides.filter((g) => g.data.section === label) }))
  .filter((g) => g.items.length > 0);

function buildBreadcrumb() {
  return [
    { label: 'Guides', href: '/guides' },
    { label: section, href: null },
    { label: title, href: null },
  ];
}
const breadcrumbs = buildBreadcrumb();

function extractHeadings(raw: string): { id: string; text: string }[] {
  const re = /^#{2,3}\s+(.+)$/gm;
  const headings: { id: string; text: string }[] = [];
  let m: RegExpExecArray | null;
  while ((m = re.exec(raw)) !== null) {
    const text = m[1];
    const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    headings.push({ id, text });
  }
  return headings.slice(0, 8);
}
const toc = extractHeadings(guide.body || '');

const flat = allGuides;
const idx = flat.findIndex((g) => g.id === guide.id);
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;
---


<Base title={`${title} - Chirp Guides`} description={description || title} ogImage={`/og/guides/${guide.id}.jpg`} graph={pageGraph} current="guides">
  <div class="doc-layout">
    <aside class="doc-sidebar" aria-label="Guides sidebar">
      <a class="doc-sidebar__back" href="/guides">
        <span class="arrow" aria-hidden="true">&larr;</span> All guides
      </a>
      <nav aria-label="Guides">
        {grouped.map((group) => (
          <div class="sidebar-group">
            <span class="overline">{group.label}</span>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={`/guides/${item.id}`} aria-current={item.id === guide.id ? 'page' : undefined}>
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main class="doc-article" id="main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          {breadcrumbs.map((crumb) => (
            <li>
              {crumb.href
                ? <a href={crumb.href}>{crumb.label}</a>
                : <span aria-current="page">{crumb.label}</span>
              }
            </li>
          ))}
        </ol>
      </nav>

      <article aria-labelledby="guide-article-title">
        <h1 id="guide-article-title">{title}</h1>
        {description && <p class="lede">{description}</p>}
        <div class="meta-row">
          <span class={`difficulty-pill difficulty-pill--${guide.data.difficulty}`}>{guide.data.difficulty}</span>
          <span class="guide-read-time mono">{guide.data.readTime} read</span>
        </div>

        <Content />

        {next && (
          <a class="next-card" href={`/guides/${next.id}`}>
            <span>
              <span class="overline">Next</span>
              <span class="next-card__title">{next.data.title}</span>
              <p>{next.data.description}</p>
            </span>
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        )}

        <footer class="doc-article__meta">
          <span>Last updated <time datetime="2026-07-04">Jul 04, 2026</time></span>
          <a href={`https://github.com/swyft/docs/edit/main/src/content/guides/${guide.id}.md`}>Edit this page on GitHub &rarr;</a>
        </footer>
      </article>
    </main>

    {toc.length > 0 && (
      <nav class="doc-toc" aria-label="On this page">
        <span class="overline">On this page</span>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.id}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Base>

<svg style="display:none" aria-hidden="true">
  <defs>
    <symbol id="icon-info" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 7.5 V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="5" r="0.9" fill="currentColor"/></symbol>
    <symbol id="icon-search" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M11 11 L14.5 14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol>
  </defs>
</svg>
