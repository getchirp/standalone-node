---
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  title: string;
  excerpt: string;
  url: string;
  category: string;
  categorySlug: string;
  date: string;
}

const { title, excerpt, url, category, categorySlug, date } = Astro.props;

---

<a href={url} class:list={['read-next-card', `read-next-category-${categorySlug}`]} aria-label={title}>
  <div class="read-next-meta">
    <span class="read-next-icon">
      <CategoryIcon name={categorySlug as any} />
    </span>
    <span class="read-next-category">{category}</span>
    <span class="read-next-date">{date}</span>
  </div>
  <h3 class="read-next-title">{title}</h3>
  <p class="read-next-excerpt">{excerpt}</p>
</a>
