---
export interface Props {
  /** The post title (e.g. "Chirp 1.4: collaborative drafts") */
  title: string;
  /** The post excerpt */
  description: string;
  /** The URL the post links to */
  url: string;
  /** The category tag (e.g. "RELEASES") */
  category?: string;
  /** Formatted date (e.g. "Jul 08") */
  date?: string;
  /** Optional custom SVG icon content. If omitted, a default cube icon is used. */
  icon?: string;
}

const { 
  title, 
  description, 
  url, 
  category = "Updates", 
  date = "Jan 01",
  icon 
} = Astro.props;
---

<article class="blog-post">
  <div class="post-header">
    <div class="post-icon">
      {
        icon ? (
          <Fragment set:html={icon} />
        ) : (
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            width="24" height="24" viewBox="0 0 24 24" 
            fill="none" stroke="#2563eb" stroke-width="2" 
            stroke-linecap="round" stroke-linejoin="round"
          >
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
            <line x1="12" y1="22.08" x2="12" y2="12" />
          </svg>
        )
      }
    </div>
    <div class="post-meta">
      <span class="category">{category}</span>
      <span class="date">{date}</span>
    </div>
  </div>
  
  <h2 class="post-title">
    <a href={url}>{title}</a>
  </h2>
  
  <p class="post-description">{description}</p>
  
  <a href={url} class="post-link">
    Read post <span class="post-link-arrow">→</span>
  </a>
</article>

<style>
  .blog-post {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 36rem; /* Approx 580px to match image */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .post-icon {
    width: 48px;
    height: 48px;
    background-color: #e9effa; /* Matches the light blue background */
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .category {
    color: #6b7280; /* Gray-500 */
    font-size: 0.875rem; /* 14px */
    font-weight: 500;
    letter-spacing: 0.025em; /* Tight letter spacing for uppercase */
    text-transform: uppercase;
  }

  .date {
    color: #9ca3af; /* Gray-400 */
    font-size: 0.875rem; /* 14px */
  }

  .post-title {
    font-size: 1.875rem; /* 30px */
    font-weight: 700;
    line-height: 1.2;
    color: #111827; /* Gray-900 */
    margin: 0 0 0.75rem 0;
  }

  .post-title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease-in-out;
  }

  .post-title a:hover {
    color: #4b5563; /* Slightly lighter on hover */
  }

  .post-description {
    font-size: 1.125rem; /* 18px */
    line-height: 1.6;
    color: #4b5563; /* Gray-600 */
    margin: 0 0 1.5rem 0;
  }

  .post-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #065f46; /* Emerald-800 / Dark Green */
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.15s ease-in-out;
  }

  .post-link:hover {
    opacity: 0.7;
  }

  .post-link-arrow {
    line-height: 1;
    margin-top: 1px; /* Visual alignment tweak */
  }
</style>