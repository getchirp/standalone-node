---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  releases: CollectionEntry<'release'>[];
}

const { releases } = Astro.props;

const grouped = releases.reduce((acc, release) => {
  const d = new Date(release.data.date);
  const key = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(release);
  return acc;
}, {} as Record<string, CollectionEntry<'release'>[]>);

const sorted = Object.entries(grouped);

const productMeta: Record<string, { icon: string; color: 'blue' | 'green' }> = {
  'Chirp': { icon: 'package', color: 'blue' },
  'swyft/insights': { icon: 'package', color: 'blue' },
  'swyft/core': { icon: 'brackets', color: 'green' },
};

const changeTagLabel: Record<string, string> = { new: 'New', fix: 'Fix', improved: 'Improved' };
---

<div class="release-timeline-layout">
  <div class="release-rail-col">
    {sorted.map(([month, groupReleases]) => (
      <div class="release-rail-group">
        <span class="release-rail-month">{month}</span>
        <span class="release-rail-count">{groupReleases.length} {groupReleases.length === 1 ? 'release' : 'releases'}</span>
      </div>
    ))}
  </div>

  <div class="release-entries-col">
    {releases.map((release) => {
      const meta = productMeta[release.data.product] ?? productMeta['swyft/core'];
      return (
        <article class="release-entry">
          <div class="release-node"></div>
          <div class="release-meta">
            <span class={`icon-badge icon-badge--${meta.color}`} aria-hidden="true">
              <Icon name={meta.icon} size={16} />
            </span>
            <span class={`release-category-label release-category-label--${meta.color}`}>{release.data.product}</span>
            <span class="release-version-tag">{release.data.version}</span>
            <time class="release-date" datetime={new Date(release.data.date).toISOString()}>
              {new Date(release.data.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}
            </time>
          </div>
          <h2 class="release-title">{release.data.title}</h2>
          <p class="release-summary">{release.data.summary}</p>
          <ul class="release-change-list">
            {release.data.changes.map((change) => (
              <li class="release-change-item">
                <span class={`release-change-tag release-change-tag--${change.type}`}>{changeTagLabel[change.type]}</span>
                <span class="release-change-text">
                  {change.text.split(/`([^`]+)`/g).map((part, index) => (
                    index % 2 === 1 ? <code>{part}</code> : part
                  ))}
                </span>
              </li>
            ))}
          </ul>
          {release.data.postSlug && (
            <a class="release-post-link" href={`/blog/${release.data.postSlug}`}>Read release post →</a>
          )}
        </article>
      );
    })}
  </div>
</div>
