---
const { href = '/', size = 27, light = false, text = true, link = true } = Astro.props;
---

{link ? (
  <a class:list={['logo-link', { light }]} href={href} aria-label="Chirp home">
    {text ? (
      <img class="logo-wordmark" src="/chirp-mark.webp" alt="Chirp" width="60px" height="50px" loading="eager" decoding="async" />
    ) : (
      <img class="logo-mark" src="/chirp-mark.webp" alt="" role="presentation" width={size} height={size} loading="eager" decoding="async" />
    )}
  </a>
) : (
  <span class:list={['logo-link', { light }]}>
    {text ? (
      <img class="logo-wordmark" src="/chirp-mark.webp" alt="Chirp" width="60" height="41" loading="eager" decoding="async" />
    ) : (
      <img class="logo-mark" src="/chirp-mark.webp" alt="" role="presentation" width={size} height={size} loading="eager" decoding="async" />
    )}
  </span>
)}
