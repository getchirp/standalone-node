    <span class="chirp-logo__notes"></span>
  </span>
</a>

<style is:global>
.chirp-logo {
  overflow: visible;
  position: relative;
  display: inline-grid;
  place-items: center;
  width: 50px;
  height: 60px;
  min-width: 50px;
  max-width: 50px;
  min-height: 60px;
  max-height: 60px;
  flex: none;
  line-height: 0;
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.chirp-logo__live,
.chirp-logo__svg {
  display: block;
  width: 50px;
  height: 60px;
  min-width: 50px;
  max-width: 50px;
  min-height: 60px;
  max-height: 60px;
}

.chirp-logo__svg {
  overflow: visible;
}


.chirp-logo__live {
  overflow: visible;
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 1;
}

.chirp-logo__notes {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: visible;
}

[data-chirp-sleep-eye],
[data-chirp-awake-eye],
[data-chirp-pupil] {
  transform-box: fill-box;
  transform-origin: center;
}

[data-chirp-upper-beak],
[data-chirp-lower-beak] {
  transform-box: view-box;
  transform-origin: 792.5px 329px;
}

[data-chirp-pupil] {
  transition: transform 70ms linear;
}

.chirp-note {
  position: absolute;
  opacity: 0;
  color: #dd4c22;
  font-weight: 800;
  line-height: 1;
  transform: translate(-50%, -50%);
  animation: chirp-note-burst 620ms cubic-bezier(.16,.78,.16,1) forwards;
  animation-delay: var(--delay, 0ms);
  will-change: transform, opacity;
}

@keyframes chirp-note-burst {
  0% {
    opacity: 0;
    transform:
      translate(-50%, -50%)
      scale(.5)
      rotate(var(--rot));
  }
  15% {
    opacity: .96;
  }
  100% {
    opacity: 0;
    transform:
      translate(-50%, -50%)
      translate(var(--dx), var(--dy))
      scale(1.06)
      rotate(calc(var(--rot) + 12deg));
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-chirp-pupil] { transition: none; }
  .chirp-note { animation-duration: 1ms !important; }
}
</style>

<!--
  CSP + Trusted-Types-safe bootstrap. This is a static same-origin module.
  It waits for window.load, then imports the interaction module without using
  a DOM injection sink.
-->
<script
  is:inline
  type="module"
  src={loaderSrc}
></script>
