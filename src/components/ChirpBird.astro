---
export interface Props {
  href?: string;
  label?: string;
  class?: string;
  loaderSrc?: string;
}

const {
  href = "/",
  label = "Chirp home",
  class: className,
  loaderSrc = "/chirp-loader.js",
} = Astro.props;
