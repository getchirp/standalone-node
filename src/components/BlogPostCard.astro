---
interface Props {
  title: string;
  description: string;
  url: string;
  category: string;
  date: string;
}

const { title, description, url, category, date } = Astro.props;
---

<article class="blog-post-card">
  <div class="post-card-meta">
    <span class="post-card-category mono">{category}</span>
    <span class="post-card-date mono">{date}</span>
  </div>
  <h2 class="post-card-title">
    <a href={url}>{title}</a>
  </h2>
  <p class="post-card-description">{description}</p>
  <a class="post-card-link" href={url}>Read post &rarr;</a>
</article>
