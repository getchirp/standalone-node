---
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  title: string;
  excerpt: string;
  url: string;
  category: string;
  categorySlug: string;
  date: string;
  compact?: boolean;
  readTime?: string;
}

const { title, excerpt, url, category, categorySlug, date, compact = false, readTime } = Astro.props;

---

<li class="timeline-post-item">
<a href={url} class:list={['timeline-post-link', `timeline-post-category-${categorySlug}`]} aria-label={title}>
  {!compact && <span class="timeline-post-dot" aria-hidden="true"></span>}

  {compact ? (
    <>
      <div class="timeline-post-meta">
        <time class="mono-meta">{date}</time>
        {readTime && <><span class="mono-meta" aria-hidden="true">·</span><span class="mono-meta">{readTime}</span></>}
      </div>
      <h2 class="timeline-post-title">{title}</h2>
      <p class="timeline-post-excerpt">{excerpt}</p>
      <div class="timeline-post-cta">
        <span>Read post</span>
        <span class="mono" aria-hidden="true">&rarr;</span>
      </div>
    </>
  ) : (
    <>
<div class="timeline-post-icon">
         <CategoryIcon name={categorySlug as any} />
       </div>
       <div class="timeline-post-meta">
         <span class="timeline-post-category mono">{category}</span>
        <span class="timeline-post-date mono">{date}</span>
      </div>
      <h2 class="timeline-post-title">{title}</h2>
      <p class="timeline-post-excerpt">{excerpt}</p>
      <div class="timeline-post-cta">
        <span>Read post</span>
        <span class="mono" aria-hidden="true">&rarr;</span>
      </div>
    </>
  )}
</a>
</li>
