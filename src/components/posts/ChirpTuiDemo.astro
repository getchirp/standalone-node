          <span>edit either source; preview updates immediately</span>
        </div>
      </section>
    </div>
  </div>

  <script>
    const initialiseChirpTuiDemos = () => {
      const roots = document.querySelectorAll("[data-chirp-tui]:not([data-ctui-initialised])");

      roots.forEach((root) => {
        if (!(root instanceof HTMLElement)) return;
        root.dataset.ctuiInitialised = "true";

        const style = root.querySelector("[data-ctui-style]");
        const terminal = root.querySelector("[data-terminal]");
        const command = root.querySelector("[data-command]");
        const restart = root.querySelector("[data-restart]");
        const screens = Array.from(root.querySelectorAll("[data-screen]"));
        const bootTasks = Array.from(root.querySelectorAll("[data-boot-task]"));
        const homeItems = Array.from(root.querySelectorAll("[data-menu-item]"));
        const collectionList = root.querySelector("[data-collection-list]");
        const entryRows = root.querySelector("[data-entry-rows]");
        const scaffoldLines = Array.from(root.querySelectorAll("[data-scaffold-line]"));
        const scaffoldDone = root.querySelector("[data-scaffold-done]");
        const scaffoldReturn = root.querySelector("[data-scaffold-return]");
        const markdown = root.querySelector("[data-markdown]");
        const previewBody = root.querySelector("[data-preview-body]");
        const previewTitle = root.querySelector("[data-preview-title]");
        const previewScientific = root.querySelector("[data-preview-scientific]");
        const editorTitle = root.querySelector("[data-editor-title]");
        const editorCollection = root.querySelector("[data-editor-collection]");
        const saveState = root.querySelector("[data-save-state]");

        if (!(terminal instanceof HTMLElement) || !(command instanceof HTMLElement)) return;

        const content = {
          posts: {
            label: "Posts",
            path: "src/content/posts",
            count: 12,
            entries: [
              { title: "From script to platform", slug: "script-to-platform", status: "published", updated: "today" },
              { title: "Why your schema should stay the source", slug: "schema-as-source", status: "draft", updated: "2d ago" },
              { title: "Editing without crossing the wire", slug: "offline-editing", status: "published", updated: "5d ago" },
              { title: "A better way to work with mdx", slug: "better-mdx", status: "published", updated: "1w ago" },
            ],
          },
          plants: {
            label: "Plants",
            path: "src/content/plants",
            count: 24,
            entries: [
              { title: "Acai", slug: "acai", status: "published", updated: "today" },
              { title: "Banana", slug: "banana", status: "published", updated: "yesterday" },
              { title: "Cape gooseberry", slug: "cape-gooseberry", status: "draft", updated: "3d ago" },
              { title: "Granadilla", slug: "granadilla", status: "published", updated: "6d ago" },
              { title: "Lemon", slug: "lemon", status: "published", updated: "1w ago" },
              { title: "Tomatillo", slug: "tomatillo", status: "draft", updated: "2w ago" },
            ],
          },
          recipes: {
            label: "Recipes",
            path: "src/content/recipes",
            count: 8,
            entries: [
              { title: "Charred brassicas", slug: "charred-brassicas", status: "published", updated: "today" },
              { title: "Preserved lemon dressing", slug: "preserved-lemon-dressing", status: "published", updated: "4d ago" },
              { title: "Tomatillo salsa", slug: "tomatillo-salsa", status: "draft", updated: "1w ago" },
              { title: "Wood-fired flatbread", slug: "wood-fired-flatbread", status: "published", updated: "2w ago" },
            ],
          },
        };

        let activated = false;
        let started = false;
        let bootRunning = false;
        let scaffoldRunning = false;
        let sufficientlyVisible = false;
        let currentScreen = "boot";
        let homeIndex = 0;
        let collectionIndex = 0;
        let entryIndex = 0;
        let activeCollection = "plants";
        let activePane = "frontmatter";
        const visibilityWaiters = new Set();
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const activateStyles = () => {
          if (activated) return;
          activated = true;
          if (style instanceof HTMLStyleElement) style.media = "all";
          root.style.visibility = "visible";
        };

        const releaseVisibilityWaiters = () => {
          if (!sufficientlyVisible || document.hidden) return;
          visibilityWaiters.forEach((resolve) => resolve());
          visibilityWaiters.clear();
        };

        const waitUntilVisible = () => {
          if (sufficientlyVisible && !document.hidden) return Promise.resolve();
          return new Promise((resolve) => visibilityWaiters.add(resolve));
        };

        const visibleSleep = async (duration) => {
          if (reduceMotion || duration <= 0) return;
          let remaining = duration;
          while (remaining > 0) {
            await waitUntilVisible();
            const slice = Math.min(remaining, 50);
            const start = performance.now();
            await new Promise((resolve) => window.setTimeout(resolve, slice));
            if (sufficientlyVisible && !document.hidden) remaining -= performance.now() - start;
          }
        };

        const showScreen = (name) => {
          currentScreen = name;
          screens.forEach((screen) => {
            if (screen instanceof HTMLElement) screen.classList.toggle("is-active", screen.dataset.screen === name);
          });
          window.setTimeout(() => terminal.focus({ preventScroll: true }), 0);
        };

        const setSelected = (items, index) => {
          items.forEach((item, itemIndex) => {
            if (!(item instanceof HTMLElement)) return;
            const selected = itemIndex === index;
            item.classList.toggle("is-selected", selected);
            item.setAttribute("aria-selected", String(selected));
            if (selected) item.scrollIntoView({ block: "nearest" });
          });
        };

        const renderCollections = () => {
          if (!(collectionList instanceof HTMLElement)) return;
          collectionList.replaceChildren();
          Object.entries(content).forEach(([key, collection], index) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "ctui-list-button";
            button.dataset.collection = key;
            button.dataset.collectionItem = "";
            button.setAttribute("role", "option");
            button.innerHTML = `<span class="ctui-selector">›</span><span class="ctui-list-name"></span><span class="ctui-list-path"></span><span class="ctui-count"></span>`;
            const name = button.querySelector(".ctui-list-name");
            const path = button.querySelector(".ctui-list-path");
            const count = button.querySelector(".ctui-count");
            if (name) name.textContent = collection.label;
            if (path) path.textContent = collection.path;
            if (count) count.textContent = String(collection.count);
            button.addEventListener("click", () => openCollection(key));
            collectionList.append(button);
          });
          collectionIndex = 0;
          setSelected(Array.from(collectionList.querySelectorAll("[data-collection-item]")), collectionIndex);
        };

        const renderEntries = (key) => {
          const collection = content[key];
          if (!collection || !(entryRows instanceof HTMLElement)) return;
          activeCollection = key;
          entryRows.replaceChildren();

          const collectionLabels = root.querySelectorAll("[data-entry-collection], [data-entry-heading]");
          collectionLabels.forEach((label) => { if (label instanceof HTMLElement) label.textContent = collection.label; });
          const count = root.querySelector("[data-entry-count]");
          if (count instanceof HTMLElement) count.textContent = `${collection.count} entries`;

          collection.entries.forEach((entry) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "ctui-row-button";
            button.dataset.entryItem = "";
            button.dataset.entrySlug = entry.slug;
            button.innerHTML = `<span class="ctui-status-dot"></span><span class="ctui-row-title"></span><span class="ctui-muted"></span><span></span><span class="ctui-muted"></span>`;
            const cells = button.children;
            cells[0]?.classList.add(entry.status === "published" ? "is-published" : "is-draft");
            if (cells[1]) cells[1].textContent = entry.title;
            if (cells[2]) cells[2].textContent = entry.slug;
            if (cells[3]) cells[3].textContent = entry.status;
            if (cells[4]) cells[4].textContent = entry.updated;
            button.addEventListener("click", () => openEditor(entry));
            entryRows.append(button);
          });

          entryIndex = 0;
          setSelected(Array.from(entryRows.querySelectorAll("[data-entry-item]")), entryIndex);
        };

        const openCollection = (key) => {
          renderEntries(key);
          showScreen("entries");
        };

        const parsemarkdown = (source) => {
          if (!(previewBody instanceof HTMLElement)) return;
          previewBody.replaceChildren();
          const lines = source.split(/\r?\n/);
          let list = null;
          let paragraph = [];

          const flushParagraph = () => {
            if (!paragraph.length) return;
            const p = document.createElement("p");
            p.textContent = paragraph.join(" ").trim();
            if (p.textContent) previewBody.append(p);
            paragraph = [];
          };

          const flushList = () => {
            if (!list) return;
            previewBody.append(list);
            list = null;
          };

          lines.forEach((line) => {
            const trimmed = line.trim();
            if (!trimmed) {
              flushParagraph();
              flushList();
              return;
            }
            if (trimmed.startsWith("## ")) {
              flushParagraph();
              flushList();
              const heading = document.createElement("h2");
              heading.textContent = trimmed.slice(3);
              previewBody.append(heading);
              return;
            }
            if (trimmed.startsWith("- ")) {
              flushParagraph();
              if (!list) list = document.createElement("ul");
              const item = document.createElement("li");
              item.textContent = trimmed.slice(2);
              list.append(item);
              return;
            }
            flushList();
            paragraph.push(trimmed);
          });

          flushParagraph();
          flushList();
        };

        const markUnsaved = () => {
          if (!(saveState instanceof HTMLElement)) return;
          saveState.textContent = "unsaved changes";
          saveState.classList.remove("is-saved");
        };

        const save = () => {
          if (!(saveState instanceof HTMLElement)) return;
          saveState.textContent = "✓ saved locally";
          saveState.classList.add("is-saved");
        };

        const resetEditorValues = (entry) => {
          const titleInput = root.querySelector('[data-field="title"]');
          const scientificInput = root.querySelector('[data-field="scientific"]');
          const slugInput = root.querySelector('[data-field="slug"]');
          if (titleInput instanceof HTMLInputElement) titleInput.value = entry.title;
          if (slugInput instanceof HTMLInputElement) slugInput.value = entry.slug;
          if (scientificInput instanceof HTMLInputElement) {
            scientificInput.value = activeCollection === "plants" && entry.slug === "acai" ? "Euterpe oleracea" : "";
          }
          if (previewTitle instanceof HTMLElement) previewTitle.textContent = entry.title;
          if (previewScientific instanceof HTMLElement) previewScientific.textContent = scientificInput instanceof HTMLInputElement ? scientificInput.value : "";
          if (editorTitle instanceof HTMLElement) editorTitle.textContent = entry.title;
          if (editorCollection instanceof HTMLElement) editorCollection.textContent = activeCollection;
          parsemarkdown(markdown instanceof HTMLTextAreaElement ? markdown.value : "");
          save();
        };

        const openEditor = (entry) => {
          resetEditorValues(entry);
          showScreen("editor");
        };

        const setPane = (pane) => {
          activePane = pane;
          root.querySelectorAll("[data-pane-tab]").forEach((tab) => {
            if (tab instanceof HTMLElement) tab.classList.toggle("is-active", tab.dataset.paneTab === pane);
          });
          root.querySelectorAll("[data-pane]").forEach((panel) => {
            if (panel instanceof HTMLElement) panel.classList.toggle("is-mobile-active", panel.dataset.pane === pane);
          });
        };

        const runBoot = async () => {
          if (bootRunning) return;
          bootRunning = true;
          root.dataset.ready = "false";
          root.dataset.boot = "typing";
          showScreen("boot");
          command.textContent = "";
          bootTasks.forEach((task) => {
            if (!(task instanceof HTMLElement)) return;
            task.classList.remove("is-visible", "is-running", "is-complete");
            const icon = task.querySelector("[data-icon]");
            const label = task.querySelector("[data-label]");
            if (icon instanceof HTMLElement) icon.textContent = "·";
            if (label instanceof HTMLElement) label.textContent = task.dataset.running || "";
          });

          const commandText = "pnpm chirp";
          await visibleSleep(210);
          if (reduceMotion) {
            command.textContent = commandText;
          } else {
            for (const character of commandText) {
              await waitUntilVisible();
              command.textContent += character;
              await visibleSleep(character === " " ? 48 : 25 + Math.random() * 20);
            }
          }

          root.dataset.boot = "running";
          await visibleSleep(260);

          for (const task of bootTasks) {
            if (!(task instanceof HTMLElement)) continue;
            task.classList.add("is-visible", "is-running");
            const icon = task.querySelector("[data-icon]");
            const label = task.querySelector("[data-label]");
            if (icon instanceof HTMLElement) icon.textContent = "◌";
            if (label instanceof HTMLElement) label.textContent = task.dataset.running || "";
            await visibleSleep(520);
            task.classList.remove("is-running");
            task.classList.add("is-complete");
            if (icon instanceof HTMLElement) icon.textContent = "✓";
            if (label instanceof HTMLElement) label.textContent = task.dataset.complete || "";
            await visibleSleep(180);
          }

          root.dataset.boot = "complete";
          await visibleSleep(340);
          homeIndex = 0;
          setSelected(homeItems, homeIndex);
          showScreen("home");
          root.dataset.ready = "true";
          bootRunning = false;
        };

        const runScaffold = async () => {
          if (scaffoldRunning) return;
          scaffoldRunning = true;
          showScreen("scaffold");
          scaffoldLines.forEach((line) => line.classList.remove("is-visible", "is-active", "is-complete"));
          if (scaffoldDone instanceof HTMLElement) scaffoldDone.classList.remove("is-visible");
          if (scaffoldReturn instanceof HTMLElement) scaffoldReturn.hidden = true;

          await visibleSleep(180);
          for (const line of scaffoldLines) {
            if (!(line instanceof HTMLElement)) continue;
            line.classList.add("is-visible", "is-active");
            const icon = line.querySelector(".ctui-scaffold-icon");
            if (icon instanceof HTMLElement) icon.textContent = "◌";
            await visibleSleep(430);
            line.classList.remove("is-active");
            line.classList.add("is-complete");
            if (icon instanceof HTMLElement) icon.textContent = "✓";
            await visibleSleep(130);
          }
          if (scaffoldDone instanceof HTMLElement) scaffoldDone.classList.add("is-visible");
          if (scaffoldReturn instanceof HTMLElement) scaffoldReturn.hidden = false;
          scaffoldRunning = false;
        };

        const activateHomeItem = () => {
          const item = homeItems[homeIndex];
          if (!(item instanceof HTMLElement)) return;
          if (item.dataset.action === "scaffold") void runScaffold();
          if (item.dataset.action === "manage") {
            renderCollections();
            showScreen("collections");
          }
        };

        homeItems.forEach((item, index) => {
          item.addEventListener("mouseenter", () => {
            homeIndex = index;
            setSelected(homeItems, homeIndex);
          });
          item.addEventListener("click", () => {
            homeIndex = index;
            activateHomeItem();
          });
        });

        root.querySelectorAll("[data-pane-tab]").forEach((tab) => {
          tab.addEventListener("click", () => {
            if (tab instanceof HTMLElement && tab.dataset.paneTab) setPane(tab.dataset.paneTab);
          });
        });

        root.querySelectorAll("[data-field]").forEach((field) => {
          field.addEventListener("input", () => {
            if (!(field instanceof HTMLInputElement)) return;
            if (field.dataset.field === "title") {
              if (previewTitle instanceof HTMLElement) previewTitle.textContent = field.value || "Untitled";
              if (editorTitle instanceof HTMLElement) editorTitle.textContent = field.value || "Untitled";
            }
            if (field.dataset.field === "scientific" && previewScientific instanceof HTMLElement) {
              previewScientific.textContent = field.value;
            }
            markUnsaved();
          });
        });

        if (markdown instanceof HTMLTextAreaElement) {
          markdown.addEventListener("input", () => {
            parsemarkdown(markdown.value);
            markUnsaved();
          });
          parsemarkdown(markdown.value);
        }

        if (restart instanceof HTMLButtonElement) restart.addEventListener("click", () => void runBoot());

        terminal.addEventListener("mousedown", (event) => {
          const target = event.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLButtonElement) return;
          terminal.focus({ preventScroll: true });
        });

        terminal.addEventListener("keydown", (event) => {
          const target = event.target;
          const editing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;

          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "s" && currentScreen === "editor") {
            event.preventDefault();
            save();
            return;
          }

          if (editing && event.key !== "Escape") return;

          if (event.key === "Escape") {
            event.preventDefault();
            if (currentScreen === "editor") showScreen("entries");
            else if (currentScreen === "entries") showScreen("collections");
            else if (currentScreen === "collections" || currentScreen === "scaffold") showScreen("home");
            return;
          }

          if (currentScreen === "home") {
            if (event.key === "ArrowDown" || event.key === "ArrowUp") {
              event.preventDefault();
              homeIndex = (homeIndex + (event.key === "ArrowDown" ? 1 : -1) + homeItems.length) % homeItems.length;
              setSelected(homeItems, homeIndex);
            } else if (event.key === "Enter") {
              event.preventDefault();
              activateHomeItem();
            }
            return;
          }

          if (currentScreen === "collections") {
            const items = collectionList instanceof HTMLElement ? Array.from(collectionList.querySelectorAll("[data-collection-item]")) : [];
            if (event.key === "ArrowDown" || event.key === "ArrowUp") {
              event.preventDefault();
              collectionIndex = (collectionIndex + (event.key === "ArrowDown" ? 1 : -1) + items.length) % items.length;
              setSelected(items, collectionIndex);
            } else if (event.key === "Enter") {
              event.preventDefault();
              const item = items[collectionIndex];
              if (item instanceof HTMLElement && item.dataset.collection) openCollection(item.dataset.collection);
            }
            return;
          }

          if (currentScreen === "entries") {
            const items = entryRows instanceof HTMLElement ? Array.from(entryRows.querySelectorAll("[data-entry-item]")) : [];
            if (event.key === "ArrowDown" || event.key === "ArrowUp") {
              event.preventDefault();
              entryIndex = (entryIndex + (event.key === "ArrowDown" ? 1 : -1) + items.length) % items.length;
              setSelected(items, entryIndex);
            } else if (event.key === "Enter") {
              event.preventDefault();
              const entry = content[activeCollection]?.entries[entryIndex];
              if (entry) openEditor(entry);
            }
            return;
          }

          if (currentScreen === "scaffold" && !scaffoldRunning && event.key === "Enter") {
            event.preventDefault();
            showScreen("home");
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            if (entry.isIntersecting) activateStyles();
            sufficientlyVisible = entry.isIntersecting && entry.intersectionRatio >= 0.28;
            releaseVisibilityWaiters();
            if (sufficientlyVisible && !started) {
              started = true;
              renderCollections();
              void runBoot();
            }
          },
          { threshold: [0, 0.08, 0.18, 0.28, 0.5, 0.75], rootMargin: "0px 0px -3% 0px" },
        );

        observer.observe(root);
        document.addEventListener("visibilitychange", releaseVisibilityWaiters);
      });
    };

    initialiseChirpTuiDemos();
    document.addEventListener("astro:page-load", initialiseChirpTuiDemos);
  </script>
</section>
