      <section class="ctui-screen" data-screen="entries" aria-label="Collection entries">
        <div class="ctui-breadcrumb"><span>chirp</span><span>/</span><span>content</span><span>/</span><strong data-entry-collection>Plants</strong></div>
        <div class="ctui-intro">
          <h2 class="ctui-heading"><span data-entry-heading>Plants</span> <span class="ctui-muted" data-entry-count>24 entries</span></h2>
