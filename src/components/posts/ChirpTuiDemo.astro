---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const css = String.raw`
  [data-chirp-tui],
  [data-chirp-tui] * {
    box-sizing: border-box;
  }

  [data-chirp-tui] {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: var(--dark-muted, #a49c87);
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
  }

  [data-chirp-tui] button,
  [data-chirp-tui] input,
  [data-chirp-tui] textarea {
    font: inherit;
  }

  [data-chirp-tui] .ctui-terminal {
    position: relative;
    display: block !important;
    width: 100% !important;
    height: 610px;
    min-width: 0 !important;
    overflow: hidden;
    margin: 0 !important;
    border: 1px solid var(--dark-line, #453e30) !important;
    border-radius: var(--radius, 14px) !important;
    background: var(--dark, #242019) !important;
    box-shadow: var(--page-shadow, 0 34px 70px -38px #2e261861) !important;
    outline: none;
  }

  [data-chirp-tui] .ctui-terminal:focus-visible {
    border-color: color-mix(in srgb, var(--dark-string, #d9a05f) 65%, var(--dark-line, #453e30)) !important;
  }

  [data-chirp-tui] .ctui-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 42px;
    padding: 0 16px;
    border-bottom: 1px solid var(--dark-line, #453e30);
    background: color-mix(in srgb, var(--dark, #242019) 94%, black);
  }

  [data-chirp-tui] .ctui-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5d5542;
  }

  [data-chirp-tui] .ctui-title {
    margin-left: 4px;
    color: #8e8674;
    font: 500 10px/1 var(--mono, ui-monospace, monospace) !important;
    letter-spacing: .01em;
  }

  [data-chirp-tui] .ctui-restart {
    appearance: none;
    display: inline-flex;
    align-items: center;
    margin: 0 0 0 auto !important;
    padding: 4px 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: var(--dark-ok, #a4b88a) !important;
    font: 500 10px/1 var(--mono, ui-monospace, monospace) !important;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    text-underline-offset: 3px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(2px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
  }

  [data-chirp-tui][data-ready="true"] .ctui-restart {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 80ms, 80ms, 0s;
  }

  [data-chirp-tui] .ctui-restart:hover {
    color: #c5d4b0 !important;
  }

  [data-chirp-tui] .ctui-restart:focus-visible {
    outline: 1px solid var(--dark-ok, #a4b88a);
    outline-offset: 4px;
  }

  [data-chirp-tui] .ctui-body {
    position: relative;
    height: 568px;
    overflow: hidden;
    font: 500 12px/1.5 var(--mono, ui-monospace, monospace) !important;
  }

  [data-chirp-tui] .ctui-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: 25px 30px 18px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(7px);
    transition: opacity 170ms ease, transform 210ms ease, visibility 0s linear 210ms;
  }

  [data-chirp-tui] .ctui-screen.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 40ms, 40ms, 0s;
  }

  [data-chirp-tui] .ctui-command-line {
    display: flex;
    align-items: baseline;
    min-height: 1.5em;
    color: #e6dfcf;
  }

  [data-chirp-tui] .ctui-prompt,
  [data-chirp-tui] .ctui-keyword {
    color: var(--dark-keyword, #e07840);
  }

  [data-chirp-tui] .ctui-command,
  [data-chirp-tui] .ctui-path {
    color: #e6dfcf;
  }

  [data-chirp-tui] .ctui-brand,
  [data-chirp-tui] .ctui-ok {
    color: var(--dark-ok, #a4b88a);
  }

  [data-chirp-tui] .ctui-string {
    color: var(--dark-string, #d9a05f);
  }

  [data-chirp-tui] .ctui-muted {
    color: #817967;
  }

  [data-chirp-tui] .ctui-dim {
    color: #6f6859;
  }

  [data-chirp-tui] .ctui-cursor {
    display: inline-block;
    width: .58em;
    height: 1.18em;
    margin-left: 2px;
    vertical-align: -.18em;
    background: var(--accent, #dd4c22);
    animation: ctui-cursor 950ms steps(1) infinite;
  }

  [data-chirp-tui][data-boot="running"] .ctui-cursor,
  [data-chirp-tui][data-boot="complete"] .ctui-cursor {
    display: none;
  }

  [data-chirp-tui] .ctui-boot-output {
    display: grid;
    gap: 6px;
    width: min(650px, 100%);
    margin-top: 20px;
  }

  [data-chirp-tui] .ctui-boot-task {
    display: grid;
    grid-template-columns: 1.5em minmax(0, 1fr);
    align-items: baseline;
    min-height: 1.5em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 150ms ease, transform 180ms ease;
  }

  [data-chirp-tui] .ctui-boot-task.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-chirp-tui] .ctui-boot-icon {
    color: var(--dark-string, #d9a05f);
  }

  [data-chirp-tui] .ctui-boot-task.is-running .ctui-boot-icon {
    animation: ctui-pulse 800ms ease-in-out infinite alternate;
  }

  [data-chirp-tui] .ctui-boot-task.is-complete .ctui-boot-icon {
    color: var(--dark-ok, #a4b88a);
    animation: none;
  }

  [data-chirp-tui] .ctui-boot-label {
    color: #b7ae99;
  }

  [data-chirp-tui] .ctui-boot-task.is-running .ctui-boot-label {
    color: #e1d9c8;
  }

  [data-chirp-tui] .ctui-intro {
    display: grid;
    gap: 4px;
    margin-bottom: 24px;
  }

  [data-chirp-tui] .ctui-eyebrow {
    margin: 0 !important;
    color: var(--dark-string, #d9a05f);
    font: 600 11px/1.3 var(--mono, ui-monospace, monospace) !important;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  [data-chirp-tui] .ctui-heading {
    margin: 0 !important;
    color: #eee7d9;
    font: 600 clamp(16px, 2vw, 20px)/1.25 var(--mono, ui-monospace, monospace) !important;
    letter-spacing: -.02em;
  }

  [data-chirp-tui] .ctui-copy {
    max-width: 650px;
    margin: 3px 0 0 !important;
    color: #908876;
    font: 500 11px/1.55 var(--mono, ui-monospace, monospace) !important;
  }

  [data-chirp-tui] .ctui-menu {
    display: grid;
    gap: 8px;
    width: min(760px, 100%);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-chirp-tui] .ctui-menu-button,
  [data-chirp-tui] .ctui-list-button,
  [data-chirp-tui] .ctui-row-button {
    appearance: none;
    width: 100%;
    margin: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  [data-chirp-tui] .ctui-menu-button {
    display: grid;
    grid-template-columns: 1.4em minmax(0, 190px) minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
    min-height: 43px;
    padding: 10px 12px !important;
    border: 1px solid transparent !important;
    border-radius: 7px !important;
  }

  [data-chirp-tui] .ctui-menu-button:hover,
  [data-chirp-tui] .ctui-menu-button.is-selected {
    border-color: #5b4a35 !important;
    background: #33291e !important;
  }

  [data-chirp-tui] .ctui-selector {
    color: transparent;
  }

  [data-chirp-tui] .is-selected .ctui-selector {
    color: var(--dark-keyword, #e07840);
  }

  [data-chirp-tui] .ctui-menu-label {
    color: #ddd5c5;
    font-weight: 600;
  }

  [data-chirp-tui] .ctui-menu-description {
    color: #807867;
  }

  [data-chirp-tui] .ctui-footer {
    display: flex;
    align-items: center;
    gap: 15px;
    min-height: 24px;
    margin-top: auto;
    padding-top: 13px;
    border-top: 1px solid #393328;
    color: #736c5e;
    font-size: 10px;
  }

  [data-chirp-tui] .ctui-key {
    color: #aaa18f;
  }

  [data-chirp-tui] .ctui-breadcrumb {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 16px;
    color: #777060;
    font-size: 10px;
  }

  [data-chirp-tui] .ctui-breadcrumb strong {
    color: #b8af9c;
    font-weight: 600;
  }

  [data-chirp-tui] .ctui-list {
    display: grid;
    gap: 4px;
    min-height: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: #514939 transparent;
  }

  [data-chirp-tui] .ctui-list-button {
    display: grid;
    grid-template-columns: 1.4em minmax(110px, .65fr) minmax(0, 1.4fr) 65px;
    gap: 12px;
    align-items: center;
    min-height: 43px;
    padding: 8px 12px !important;
    border: 1px solid transparent !important;
    border-radius: 6px !important;
  }

  [data-chirp-tui] .ctui-list-button:hover,
  [data-chirp-tui] .ctui-list-button.is-selected {
    border-color: #4d4334 !important;
    background: #302a21 !important;
  }

  [data-chirp-tui] .ctui-list-name {
    color: #d8d0c0;
    font-weight: 600;
  }

  [data-chirp-tui] .ctui-list-path {
    color: #777060;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  [data-chirp-tui] .ctui-count {
    justify-self: end;
    color: var(--dark-string, #d9a05f);
  }

  [data-chirp-tui] .ctui-table-wrap {
    min-height: 0;
    overflow: auto;
    border: 1px solid #40392d;
    border-radius: 7px;
    scrollbar-width: thin;
    scrollbar-color: #514939 transparent;
  }

  [data-chirp-tui] .ctui-table {
    min-width: 720px;
  }

  [data-chirp-tui] .ctui-table-head,
  [data-chirp-tui] .ctui-row-button {
    display: grid;
    grid-template-columns: 24px minmax(160px, 1.2fr) minmax(150px, 1fr) 90px 105px;
    align-items: center;
    gap: 13px;
    min-height: 39px;
    padding: 0 13px !important;
  }

  [data-chirp-tui] .ctui-table-head {
    position: sticky;
    top: 0;
    z-index: 2;
    border-bottom: 1px solid #40392d;
    background: #29241d;
    color: #70695b;
    font-size: 9px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  [data-chirp-tui] .ctui-row-button {
    border-bottom: 1px solid #353027 !important;
    color: #9f9786;
  }

  [data-chirp-tui] .ctui-row-button:last-child {
    border-bottom: 0 !important;
  }

  [data-chirp-tui] .ctui-row-button:hover,
  [data-chirp-tui] .ctui-row-button.is-selected {
    background: #332b21 !important;
  }

  [data-chirp-tui] .ctui-row-button.is-selected {
    box-shadow: inset 2px 0 var(--dark-keyword, #e07840);
  }

  [data-chirp-tui] .ctui-row-title {
    color: #ded6c7;
    font-weight: 600;
  }

  [data-chirp-tui] .ctui-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #786f5e;
  }

  [data-chirp-tui] .ctui-status-dot.is-published {
    background: var(--dark-ok, #a4b88a);
  }

  [data-chirp-tui] .ctui-status-dot.is-draft {
    background: var(--dark-string, #d9a05f);
  }

  [data-chirp-tui] .ctui-editor-screen {
    padding: 17px 18px 13px;
  }

  [data-chirp-tui] .ctui-editor-topbar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 30px;
    margin-bottom: 10px;
    color: #756e60;
    font-size: 10px;
  }

  [data-chirp-tui] .ctui-editor-title {
    color: #d7cfbf;
    font-weight: 600;
  }

  [data-chirp-tui] .ctui-save-state {
    margin-left: auto;
    color: #777060;
  }

  [data-chirp-tui] .ctui-save-state.is-saved {
    color: var(--dark-ok, #a4b88a);
  }

  [data-chirp-tui] .ctui-pane-tabs {
    display: none;
    gap: 5px;
    margin: 0 0 9px;
  }

  [data-chirp-tui] .ctui-pane-tab {
    appearance: none;
    padding: 5px 8px !important;
    border: 1px solid #40392d !important;
    border-radius: 4px !important;
    background: transparent !important;
    color: #8a8271 !important;
    cursor: pointer;
  }

  [data-chirp-tui] .ctui-pane-tab.is-active {
    border-color: #68543b !important;
    background: #332a20 !important;
    color: #ddd5c5 !important;
  }

  [data-chirp-tui] .ctui-editor-grid {
    display: grid;
    grid-template-columns: minmax(205px, .78fr) minmax(260px, 1.08fr) minmax(280px, 1.14fr);
    min-width: 0;
    min-height: 0;
    flex: 1;
    overflow: hidden;
    border: 1px solid #40392d;
    border-radius: 7px;
  }

  [data-chirp-tui] .ctui-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid #40392d;
    background: #28231c;
  }

  [data-chirp-tui] .ctui-pane:last-child {
    border-right: 0;
  }

  [data-chirp-tui] .ctui-pane-heading {
    display: flex;
    align-items: center;
    min-height: 34px;
    margin: 0 !important;
    padding: 0 11px;
    border-bottom: 1px solid #40392d;
    color: #786f60;
    font: 600 9px/1 var(--mono, ui-monospace, monospace) !important;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  [data-chirp-tui] .ctui-fields {
    display: grid;
    gap: 10px;
    min-height: 0;
    margin: 0;
    padding: 12px;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: #514939 transparent;
  }

  [data-chirp-tui] .ctui-field {
    display: grid;
    gap: 4px;
  }

  [data-chirp-tui] .ctui-field-label {
    color: var(--dark-keyword, #e07840);
    font-size: 9px;
  }

  [data-chirp-tui] .ctui-field-input {
    width: 100%;
    min-width: 0;
    margin: 0 !important;
    padding: 6px 7px !important;
    border: 1px solid #40392d !important;
    border-radius: 4px !important;
    background: #211d17 !important;
    color: #d6cebf !important;
    outline: none;
  }

  [data-chirp-tui] .ctui-field-input:focus {
    border-color: #87623d !important;
    box-shadow: 0 0 0 1px #87623d;
  }

  [data-chirp-tui] .ctui-markdown {
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex: 1;
    resize: none;
    margin: 0 !important;
    padding: 12px !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: #211d17 !important;
    color: #cfc6b6 !important;
    font: 500 11px/1.6 var(--mono, ui-monospace, monospace) !important;
    outline: none;
    tab-size: 2;
  }

  [data-chirp-tui] .ctui-preview-wrap {
    min-height: 0;
    flex: 1;
    padding: 11px;
    overflow: auto;
    background: #1f1b16;
    scrollbar-width: thin;
    scrollbar-color: #514939 transparent;
  }

  [data-chirp-tui] .ctui-preview {
    min-height: 100%;
    padding: 24px 25px;
    border-radius: 5px;
    background: var(--surface, #fbf9f2);
    color: var(--ink, #221e17);
    font-family: var(--font-system, Georgia, serif);
    box-shadow: 0 15px 35px -26px #000;
  }

  [data-chirp-tui] .ctui-preview .ctui-preview-title {
    margin: 0 0 5px !important;
    color: var(--ink, #221e17) !important;
    font: 600 clamp(21px, 2.2vw, 31px)/1.05 var(--font-system, Georgia, serif) !important;
    letter-spacing: -.035em;
  }

  [data-chirp-tui] .ctui-preview-scientific {
    margin: 0 0 18px !important;
    color: var(--muted, #59564d);
    font: italic 12px/1.4 var(--font-system, Georgia, serif) !important;
  }

  [data-chirp-tui] .ctui-preview-body h2 {
    margin: 18px 0 6px !important;
    color: var(--ink, #221e17) !important;
    font: 600 16px/1.15 var(--font-system, Georgia, serif) !important;
  }

  [data-chirp-tui] .ctui-preview-body p,
  [data-chirp-tui] .ctui-preview-body li {
    color: var(--ink-soft, #3d382c) !important;
    font: 400 12px/1.58 var(--font-system, Georgia, serif) !important;
  }

  [data-chirp-tui] .ctui-preview-body p {
    margin: 0 0 10px !important;
  }

  [data-chirp-tui] .ctui-preview-body ul {
    margin: 0 0 10px 18px !important;
    padding: 0 !important;
  }

  [data-chirp-tui] .ctui-scaffold-log {
    display: grid;
    gap: 7px;
    width: min(760px, 100%);
    margin-top: 6px;
  }

  [data-chirp-tui] .ctui-scaffold-line {
    display: grid;
    grid-template-columns: 1.5em minmax(0, 1fr);
    opacity: 0;
    transform: translateY(3px);
  }

  [data-chirp-tui] .ctui-scaffold-line.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 150ms ease, transform 180ms ease;
  }

  [data-chirp-tui] .ctui-scaffold-line.is-active .ctui-scaffold-icon {
    color: var(--dark-string, #d9a05f);
    animation: ctui-pulse 800ms ease-in-out infinite alternate;
  }

  [data-chirp-tui] .ctui-scaffold-line.is-complete .ctui-scaffold-icon {
    color: var(--dark-ok, #a4b88a);
    animation: none;
  }

  [data-chirp-tui] .ctui-done {
    margin-top: 17px;
    padding: 10px 12px;
    border: 1px solid #654328;
    border-radius: 6px;
    background: #4d321f;
    color: #e6d8c6;
    opacity: 0;
    transform: translateY(4px);
  }

  [data-chirp-tui] .ctui-done.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 180ms ease, transform 210ms ease;
  }

  @keyframes ctui-cursor {
    50% { opacity: 0; }
  }

  @keyframes ctui-pulse {
    from { opacity: .45; }
    to { opacity: 1; }
  }

  @media (max-width: 860px) {
    [data-chirp-tui] .ctui-editor-grid {
      grid-template-columns: minmax(190px, .8fr) minmax(230px, 1fr) minmax(250px, 1fr);
      overflow-x: auto;
    }

    [data-chirp-tui] .ctui-screen {
      padding-inline: 20px;
    }
  }

  @media (max-width: 680px) {
    [data-chirp-tui] .ctui-terminal {
      height: 600px;
      border-radius: 11px !important;
    }

    [data-chirp-tui] .ctui-body {
      height: 558px;
      font-size: 10.5px !important;
    }

    [data-chirp-tui] .ctui-screen {
      padding: 19px 15px 13px;
    }

    [data-chirp-tui] .ctui-menu-button {
      grid-template-columns: 1.2em minmax(0, 1fr);
    }

    [data-chirp-tui] .ctui-menu-description {
      grid-column: 2;
    }

    [data-chirp-tui] .ctui-list-button {
      grid-template-columns: 1.2em minmax(95px, 1fr) 52px;
    }

    [data-chirp-tui] .ctui-list-path {
      display: none;
    }

    [data-chirp-tui] .ctui-pane-tabs {
      display: flex;
    }

    [data-chirp-tui] .ctui-editor-grid {
      display: block;
      overflow: hidden;
    }

    [data-chirp-tui] .ctui-pane {
      display: none;
      height: 100%;
      border-right: 0;
    }

    [data-chirp-tui] .ctui-pane.is-mobile-active {
      display: flex;
    }

    [data-chirp-tui] .ctui-editor-screen {
      padding: 12px;
    }

    [data-chirp-tui] .ctui-preview {
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-chirp-tui] .ctui-screen,
    [data-chirp-tui] .ctui-boot-task,
    [data-chirp-tui] .ctui-scaffold-line,
    [data-chirp-tui] .ctui-done,
    [data-chirp-tui] .ctui-restart {
      transition: none !important;
      transform: none !important;
    }

    [data-chirp-tui] .ctui-cursor,
    [data-chirp-tui] .ctui-boot-task.is-running .ctui-boot-icon,
    [data-chirp-tui] .ctui-scaffold-line.is-active .ctui-scaffold-icon {
      animation: none !important;
    }
  }
`;
