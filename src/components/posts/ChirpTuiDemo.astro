              <label class="ctui-field">
                <span class="ctui-field-label">slug</span>
                <input class="ctui-field-input" data-field="slug" value="acai" />
              </label>
              <label class="ctui-field">
                <span class="ctui-field-label">family</span>
                <input class="ctui-field-input" data-field="family" value="Arecaceae" />
              </label>
              <label class="ctui-field">
                <span class="ctui-field-label">position</span>
                <input class="ctui-field-input" data-field="position" value="Full sun to partial shade" />
              </label>
              <label class="ctui-field">
                <span class="ctui-field-label">when.sow</span>
                <input class="ctui-field-input" data-field="sow" value="Spring" />
