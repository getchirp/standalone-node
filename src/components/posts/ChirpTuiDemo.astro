        <div class="ctui-editor-grid">
          <section class="ctui-pane is-mobile-active" data-pane="frontmatter">
            <h3 class="ctui-pane-heading">Frontmatter</h3>
            <div class="ctui-fields">
              <label class="ctui-field">
                <span class="ctui-field-label">common_name</span>
