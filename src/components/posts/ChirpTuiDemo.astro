        </div>
      </section>

      <section class="ctui-screen ctui-editor-screen" data-screen="editor" aria-label="Edit content entry">
        <div class="ctui-editor-topbar">
          <span>chirp / content / <span data-editor-collection>plants</span> /</span>
          <span class="ctui-editor-title" data-editor-title>Acai</span>
