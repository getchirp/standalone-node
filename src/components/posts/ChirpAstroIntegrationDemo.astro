  <script>
    const initialiseChirpAstroIntegrationDemos = () => {
      const roots = document.querySelectorAll("[data-chirp-astro-integration]:not([data-cai-initialised])");

      roots.forEach((root) => {
        if (!(root instanceof HTMLElement)) return;
        root.dataset.caiInitialised = "true";

        const style = root.querySelector("[data-cai-style]");
        const frame = root.querySelector("[data-frame]");
        const command = root.querySelector("[data-command]");
        const tasks = Array.from(root.querySelectorAll("[data-task]"));
        const openEditorLink = root.querySelector("[data-open-editor]");
        const replay = root.querySelector("[data-replay]");
        const browserBack = root.querySelector("[data-browser-back]");
        const editorBack = root.querySelector("[data-editor-back]");
        const browserUrl = root.querySelector("[data-browser-url]");
        const collectionButtons = Array.from(root.querySelectorAll("[data-collection]"));
        const collectionTitle = root.querySelector("[data-collection-title]");
        const collectionMeta = root.querySelector("[data-collection-meta]");
        const entryList = root.querySelector("[data-entry-list]");
        const editorCanvas = root.querySelector("[data-editor-canvas]");
        const editorName = root.querySelector("[data-editor-name]");
        const editorCollection = root.querySelector("[data-editor-collection]");
        const fieldsContainer = root.querySelector("[data-fields]");
        const fieldCount = root.querySelector("[data-field-count]");
        const saveState = root.querySelector("[data-save-state]");
        const togglePanel = root.querySelector("[data-toggle-panel]");
        const demoContentNode = root.querySelector("[data-demo-content]");

        if (!(frame instanceof HTMLElement) || !(command instanceof HTMLElement)) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let stylesActivated = false;
        let started = false;
        let running = false;
        let sufficientlyVisible = false;
        let autoAdvanceToken = 0;
        let saveTimer = 0;
        const visibilityWaiters = new Set();

        let demoData = { collections: {} };
        if (demoContentNode instanceof HTMLScriptElement) {
          try {
            demoData = JSON.parse(demoContentNode.textContent || "{}");
          } catch (error) {
            console.warn("Unable to read Chirp Astro integration demo content.", error);
          }
        }

        const collections = demoData.collections || {};
        let activeCollectionKey = "posts";
        let activeEntryId = null;


        const activateStyles = () => {
          if (stylesActivated) return;
          stylesActivated = true;
          if (style instanceof HTMLStyleElement) style.media = "all";
          root.style.visibility = "visible";
        };

        const releaseVisibilityWaiters = () => {
          if (!sufficientlyVisible || document.hidden) return;
          visibilityWaiters.forEach((resolve) => resolve());
          visibilityWaiters.clear();
        };

        const waitUntilVisible = () => {
          if (sufficientlyVisible && !document.hidden) return Promise.resolve();
          return new Promise((resolve) => visibilityWaiters.add(resolve));
        };

        const visibleSleep = async (duration) => {
          if (reduceMotion || duration <= 0) return;
          let remaining = duration;
          while (remaining > 0) {
            await waitUntilVisible();
            const slice = Math.min(remaining, 50);
            const start = performance.now();
            await new Promise((resolve) => window.setTimeout(resolve, slice));
            if (sufficientlyVisible && !document.hidden) remaining -= performance.now() - start;
          }
        };

        const resetTasks = () => {
          tasks.forEach((task) => {
            if (!(task instanceof HTMLElement)) return;
            task.classList.remove("is-visible", "is-running", "is-complete");
            const icon = task.querySelector("[data-task-icon]");
            const label = task.querySelector("[data-task-label]");
            if (icon instanceof HTMLElement) icon.textContent = "·";
            if (label instanceof HTMLElement) label.textContent = task.dataset.running || "";
          });
        };

        const getCollection = (collectionKey = activeCollectionKey) => collections[collectionKey];

        const getEntry = (collectionKey, entryId) => {
          const collection = getCollection(collectionKey);
          return collection?.entries?.find((entry) => entry.id === entryId) || null;
        };

        const setBrowserScreen = (screen) => {
          root.dataset.browserScreen = screen;
          if (!(browserUrl instanceof HTMLElement)) return;
          const base = `localhost:4321/__chirp/content/${activeCollectionKey}`;
          browserUrl.textContent = screen === "editor" && activeEntryId
            ? `${base}/${activeEntryId}`
            : base;
        };

        const escapeHtml = (value) => String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

        const renderInlinemarkdown = (value) => escapeHtml(value)
          .replace(/`([^`]+)`/g, "<code>$1</code>")
          .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
          .replace(/\*([^*]+)\*/g, "<em>$1</em>");

        const markdownToHtml = (markdown) => {
          const lines = String(markdown || "").trim().split(/\r?\n/);
          const html = [];
          let paragraph = [];
          let list = [];
          let paragraphIndex = 0;

          const flushParagraph = () => {
            if (!paragraph.length) return;
            const className = paragraphIndex === 0 ? ' class="csd-lead"' : "";
            html.push(`<p${className}>${renderInlinemarkdown(paragraph.join(" "))}</p>`);
            paragraph = [];
            paragraphIndex += 1;
          };

          const flushList = () => {
            if (!list.length) return;
            html.push(`<ul>${list.map((item) => `<li>${renderInlinemarkdown(item)}</li>`).join("")}</ul>`);
            list = [];
          };

          lines.forEach((line) => {
            const trimmed = line.trim();
            if (!trimmed) {
              flushParagraph();
              flushList();
              return;
            }

            const listMatch = trimmed.match(/^[-*]\s+(.+)$/);
            if (listMatch) {
              flushParagraph();
              list.push(listMatch[1]);
              return;
            }

            flushList();
            const headingMatch = trimmed.match(/^(#{1,3})\s+(.+)$/);
            if (headingMatch) {
              flushParagraph();
              const level = headingMatch[1].length;
              html.push(`<h${level}>${renderInlinemarkdown(headingMatch[2])}</h${level}>`);
              return;
            }

            const quoteMatch = trimmed.match(/^>\s+(.+)$/);
            if (quoteMatch) {
              flushParagraph();
              html.push(`<blockquote>${renderInlinemarkdown(quoteMatch[1])}</blockquote>`);
              return;
            }

            paragraph.push(trimmed);
          });

          flushParagraph();
          flushList();
          html.push('<span class="csd-slash-hint">Type <strong>/</strong> for commands</span>');
          return html.join("");
        };

        const createFieldControl = (key, value) => {
          const label = document.createElement("label");
          label.className = "csd-field";

          const fieldLabel = document.createElement("span");
          fieldLabel.className = "csd-field-label";
          fieldLabel.textContent = key;
          label.append(fieldLabel);

          if (key === "image" && typeof value === "string") {
            const imageField = document.createElement("div");
            imageField.className = "csd-image-field";
            const thumb = document.createElement("span");
            thumb.className = "csd-image-thumb";
            thumb.textContent = "✦";
            const copy = document.createElement("span");
            copy.className = "csd-image-copy";
            copy.textContent = value;
            const path = document.createElement("small");
            path.textContent = `src/assets/${activeCollectionKey}/`;
            copy.append(path);
            imageField.append(thumb, copy);
            label.append(imageField);
            return label;
          }

          let control;
          if (key === "status") {
            control = document.createElement("select");
            control.className = "csd-field-select";
            ["published", "draft"].forEach((status) => {
              const option = document.createElement("option");
              option.value = status;
              option.textContent = status;
              option.selected = String(value) === status;
              control.append(option);
            });
          } else if (typeof value === "boolean") {
            control = document.createElement("select");
            control.className = "csd-field-select";
            ["true", "false"].forEach((booleanValue) => {
              const option = document.createElement("option");
              option.value = booleanValue;
              option.textContent = booleanValue;
              option.selected = String(value) === booleanValue;
              control.append(option);
            });
          } else {
            control = document.createElement("input");
            control.className = "csd-field-input";
            control.type = typeof value === "number" ? "number" : "text";
            control.value = Array.isArray(value) ? value.join(", ") : String(value ?? "");
          }

          control.dataset.fieldKey = key;
          if (key === "title" || key === "common_name") control.dataset.titleInput = "true";
          label.append(control);
          return label;
        };

        const renderFrontmatter = (entry) => {
          if (!(fieldsContainer instanceof HTMLElement)) return;
          fieldsContainer.replaceChildren();
          const fields = Object.entries(entry.frontmatter || {});
          if (fieldCount instanceof HTMLElement) fieldCount.textContent = `${fields.length} fields`;
          fields.forEach(([key, value]) => fieldsContainer.append(createFieldControl(key, value)));
        };

        const renderRows = (collectionKey) => {
          const collection = getCollection(collectionKey);
          if (!collection || !(entryList instanceof HTMLElement)) return;
          activeCollectionKey = collectionKey;
          activeEntryId = null;
          entryList.replaceChildren();
          if (collectionTitle instanceof HTMLElement) collectionTitle.textContent = collection.title;
          if (collectionMeta instanceof HTMLElement) collectionMeta.textContent = `${collection.total} entries · ${collection.path}`;

          collection.entries.forEach((entry) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "csd-entry-row";
            button.dataset.entry = entry.id;
            button.innerHTML = '<span class="csd-entry-title"></span><span class="csd-cell"></span><span class="csd-status"></span><span class="csd-cell"></span>';
            const cells = button.children;
            if (cells[0]) cells[0].textContent = entry.title;
            if (cells[1]) cells[1].textContent = entry.slug;
            if (cells[2]) {
              cells[2].textContent = entry.status.charAt(0).toUpperCase() + entry.status.slice(1);
              if (entry.status === "draft") cells[2].classList.add("is-draft");
            }
            if (cells[3]) cells[3].textContent = entry.updated;
            button.addEventListener("click", () => openEntry(collectionKey, entry.id));
            entryList.append(button);
          });

          setBrowserScreen("entries");
        };

        const openEntry = (collectionKey, entryId) => {
          const collection = getCollection(collectionKey);
          const entry = getEntry(collectionKey, entryId);
          if (!collection || !entry) return;

          activeCollectionKey = collectionKey;
          activeEntryId = entryId;
          if (editorCollection instanceof HTMLElement) editorCollection.textContent = collection.title;
          if (editorName instanceof HTMLElement) editorName.textContent = entry.title;
          if (editorCanvas instanceof HTMLElement) editorCanvas.innerHTML = entry.runtimeHtml || markdownToHtml(entry.markdown);
          renderFrontmatter(entry);
          setBrowserScreen("editor");
          root.dataset.complete = "true";
        };

        const morphToBrowser = () => {
          if (root.dataset.mode === "browser") return;
          root.dataset.mode = "browser";
          activeCollectionKey = "posts";
          activeEntryId = null;
          renderRows(activeCollectionKey);
          collectionButtons.forEach((button) => button.classList.toggle(
            "is-active",
            button instanceof HTMLElement && button.dataset.collection === activeCollectionKey,
          ));
          root.dataset.complete = "true";
        };

        const runSequence = async () => {
          if (running) return;
          running = true;
          autoAdvanceToken += 1;
          root.dataset.mode = "terminal";
          root.dataset.browserScreen = "entries";
          root.dataset.panelOpen = "false";
          root.dataset.running = "false";
          root.dataset.terminalReady = "false";
          root.dataset.complete = "false";
          activeCollectionKey = "posts";
          activeEntryId = null;
          command.textContent = "";
          resetTasks();

          const commandText = "pnpm dev";
          await visibleSleep(220);
          if (reduceMotion) {
            command.textContent = commandText;
          } else {
            for (const character of commandText) {
              await waitUntilVisible();
              command.textContent += character;
              await visibleSleep(character === " " ? 48 : 24 + Math.random() * 18);
            }
          }

          root.dataset.running = "true";
          await visibleSleep(250);

          for (const task of tasks) {
            if (!(task instanceof HTMLElement)) continue;
            task.classList.add("is-visible", "is-running");
            const icon = task.querySelector("[data-task-icon]");
            const label = task.querySelector("[data-task-label]");
            if (icon instanceof HTMLElement) icon.textContent = "◌";
            if (label instanceof HTMLElement) label.textContent = task.dataset.running || "";
            await visibleSleep(500);
            task.classList.remove("is-running");
            task.classList.add("is-complete");
            if (icon instanceof HTMLElement) icon.textContent = "✓";
            if (label instanceof HTMLElement) label.textContent = task.dataset.complete || "";
            await visibleSleep(155);
          }

          root.dataset.running = "false";
          root.dataset.terminalReady = "true";
          running = false;
        };

        const markUnsavedThenSaved = () => {
          if (!(saveState instanceof HTMLElement)) return;
          saveState.textContent = "Unsaved changes";
          saveState.style.color = "var(--amber-text, #805617)";
          window.clearTimeout(saveTimer);
          saveTimer = window.setTimeout(() => {
            saveState.textContent = "✓ Saved locally";
            saveState.style.color = "";
          }, 700);
        };

        if (openEditorLink instanceof HTMLAnchorElement) {
          openEditorLink.addEventListener("click", (event) => {
            event.preventDefault();
            morphToBrowser();
          });
        }

        if (replay instanceof HTMLButtonElement) replay.addEventListener("click", () => void runSequence());

        const returnToCollection = () => {
          autoAdvanceToken += 1;
          const collectionKey = activeCollectionKey;
          activeEntryId = null;
          renderRows(collectionKey);
        };

        if (browserBack instanceof HTMLButtonElement) {
          browserBack.addEventListener("click", () => {
            if (root.dataset.browserScreen === "editor") returnToCollection();
          });
        }

        if (editorBack instanceof HTMLButtonElement) {
          editorBack.addEventListener("click", returnToCollection);
        }

        collectionButtons.forEach((button) => {
          button.addEventListener("click", () => {
            if (!(button instanceof HTMLElement) || !button.dataset.collection) return;
            autoAdvanceToken += 1;
            collectionButtons.forEach((item) => item.classList.toggle("is-active", item === button));
            renderRows(button.dataset.collection);
          });
        });

        root.querySelectorAll("[data-tool]").forEach((tool) => {
          tool.addEventListener("click", () => {
            root.querySelectorAll("[data-tool]").forEach((item) => item.classList.toggle("is-active", item === tool));
            frame.focus({ preventScroll: true });
          });
        });

        if (togglePanel instanceof HTMLButtonElement) {
          togglePanel.addEventListener("click", () => {
            root.dataset.panelOpen = String(root.dataset.panelOpen !== "true");
          });
        }

        if (editorCanvas instanceof HTMLElement) {
          editorCanvas.addEventListener("input", () => {
            const entry = activeEntryId ? getEntry(activeCollectionKey, activeEntryId) : null;
            if (entry) entry.runtimeHtml = editorCanvas.innerHTML;
            markUnsavedThenSaved();
          });
        }

        if (fieldsContainer instanceof HTMLElement) {
          fieldsContainer.addEventListener("input", (event) => {
            const control = event.target;
            if (!(control instanceof HTMLInputElement) && !(control instanceof HTMLSelectElement)) return;
            const key = control.dataset.fieldKey;
            const entry = activeEntryId ? getEntry(activeCollectionKey, activeEntryId) : null;
            if (!key || !entry) return;

            let value = control.value;
            const originalValue = entry.frontmatter?.[key];
            if (typeof originalValue === "boolean") value = control.value === "true";
            if (typeof originalValue === "number") value = Number(control.value);
            entry.frontmatter[key] = value;

            if (control.dataset.titleInput === "true") {
              const title = String(value || "Untitled");
              entry.title = title;
              if (editorName instanceof HTMLElement) editorName.textContent = title;
              const heading = editorCanvas?.querySelector("[data-editor-entry-title]");
              if (heading instanceof HTMLElement) heading.textContent = title;
            }
            markUnsavedThenSaved();
          });
        }

        frame.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && root.dataset.mode === "browser" && root.dataset.browserScreen === "editor") {
            event.preventDefault();
            returnToCollection();
          }
          if (event.key.toLowerCase() === "r" && (event.metaKey || event.ctrlKey)) {
            event.preventDefault();
            void runSequence();
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            const entry = entries[0];
            if (!entry) return;
            if (entry.isIntersecting) activateStyles();
            sufficientlyVisible = entry.isIntersecting && entry.intersectionRatio >= 0.24;
            releaseVisibilityWaiters();
            if (sufficientlyVisible && !started) {
              started = true;
              void runSequence();
            }
          },
          { threshold: [0, 0.06, 0.14, 0.24, 0.4, 0.7], rootMargin: "0px 0px -3% 0px" },
        );

        observer.observe(root);
        document.addEventListener("visibilitychange", releaseVisibilityWaiters);
      });
    };

    initialiseChirpAstroIntegrationDemos();
    document.addEventListener("astro:page-load", initialiseChirpAstroIntegrationDemos);
  </script>
</section>
