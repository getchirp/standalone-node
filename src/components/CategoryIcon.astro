---
interface Props {
  name: 'engineering' | 'product' | 'releases' | 'philosophy';
  size?: number;
}

const { name, size = 16 } = Astro.props;

const paths: Record<string, string> = {
  engineering:
    '<path d="M5 3 L1 8 L5 13 M11 3 L15 8 L11 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  product:
    '<rect x="2" y="2" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M2 6.5 H14 M6.5 6.5 V14" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  releases:
    '<path d="M8 1.5 L14 5 V11 L8 14.5 L2 11 V5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M2 5 L8 8.5 L14 5 M8 8.5 V14.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  philosophy:
    '<circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8" cy="8" r="2" fill="currentColor"/>',
};
---

<svg width={size} height={size} viewBox="0 0 16 16" style="display:block" aria-hidden="true" focusable="false" role="img" set:html={paths[name]} />
