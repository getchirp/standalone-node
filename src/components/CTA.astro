---
interface Props {
  href?: string;
  label?: string;
  variant?: 'primary' | 'console' | 'ghost';
  command?: string;
  copyLabel?: string;
}

const {
  href = '#get',
  label = 'Get started',
  variant = 'primary',
  command,
  copyLabel = 'copy',
} = Astro.props;
---

{command ? (
  <div class:list={['command-cta', `command-cta-${variant}`]}>
    <span class="command-dot" aria-hidden="true"></span>
    <code>{command}</code>
    <button type="button" class="command-copy" data-copy-command={command}>
      {copyLabel}
    </button>
    <span class="visually-hidden" data-copy-status aria-live="polite"></span>
  </div>
) : (
  <a class:list={['cta-control', `cta-control-${variant}`]} href={href}>{label}</a>
)}
