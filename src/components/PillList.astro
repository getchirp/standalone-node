---
interface Pill {
  label: string;
  href?: string;
}

interface Props {
  items: Array<string | Pill>;
  label?: string;
  tone?: 'quiet' | 'dark' | 'warm';
}

const { items, label, tone = 'quiet' } = Astro.props;
---

<ul class:list={['pill-list', `pill-list-${tone}`]} aria-label={label}>
  {items.map((item) => {
    const pill = typeof item === 'string' ? { label: item } : item;
    return (
      <li>
        {pill.href ? <a href={pill.href}>{pill.label}</a> : <span>{pill.label}</span>}
      </li>
    );
  })}
</ul>
